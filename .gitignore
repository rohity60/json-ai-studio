# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/
apps/web/.next/

# IDE / tooling
.idea/
.claude/*
# project skills are shared; worktrees/local settings stay ignored
!.claude/skills/
.mdc

# Logs (ADR-0017) — rotating log files, never committed
logs/
apps/api/logs/
*.log
*.log.[0-9]*

# Env files — real credentials never committed; examples stay tracked
.env
.env.*
!.env.example

# Python build / test artifacts (any package)
*.egg-info/
.pytest_cache/

# Anna App — build output and local state; sources, .anna/app.json and the
# CI workflow stay tracked
apps/anna/bundle/
apps/anna/ui/node_modules/
apps/anna/executas/*/build/
apps/anna/executas/*/dist/
apps/anna/.anna/dev-app.json
# Downloaded Anna docs corpus (re-fetchable llms.txt / llms-full.txt)
.anna-docs/

# Stray local file, unrelated to the project
/card.json
