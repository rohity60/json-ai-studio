# OS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/
apps/web/.next/

# IDE / tooling
.idea/
.claude/
.mdc

# Logs (ADR-0017) — rotating log files, never committed
logs/
apps/api/logs/
*.log
*.log.[0-9]*

# Env files — real credentials never committed; examples stay tracked
.env
.env.*
!.env.example

# Anna App: CLI dev state + local copy of Anna's LLM docs corpus (third-party, not redistributed)
.anna/
.anna-docs/
*.egg-info/
# Anna App bundle is build output of apps/anna/ui (npm run build)
apps/anna/bundle/
