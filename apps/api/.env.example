# Copy to .env (gitignored). All optional — without DATABASE_URL/AUTH0_* the
# API runs in anonymous-only mode (login returns 503), ADR-0015.

# LLM deployment keys (config/deployments.yaml, ADR-0016). A missing/empty
# key auto-disables that deployment at load time.
GOOGLE_AI_STUDIO_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
# Ollama endpoint; unset disables the ollama_local deployment.
OLLAMA_BASE_URL=http://localhost:11434

# Shared anonymous quota pool key
GENERAL_API_KEY=dev-default-key

# Postgres via docker-compose (host port 5433; in-compose uses db:5432)
DATABASE_URL=postgresql+asyncpg://json_ai:json_ai@localhost:5433/json_ai_studio

# Auth0 tenant domain (no scheme) + API identifier (audience)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Quota overrides (defaults shown)
# ANON_MONTHLY_CREDIT_LIMIT=10000
# ANON_PER_MINUTE_TOKEN_LIMIT=10000
# ANON_REQUESTS_PER_MINUTE=10
# USER_MONTHLY_CREDIT_LIMIT=2000
# USER_PER_MINUTE_TOKEN_LIMIT=30000
# USER_REQUESTS_PER_MINUTE=30

# Logging (ADR-0017; defaults shown). LOG_LEVEL=DEBUG enables full-payload
# debug logs (working JSON, prompts, LLM output, diffs). Files rotate by size:
# LOG_MAX_BYTES per file, LOG_BACKUP_COUNT old files kept (app.log.1..N).
# LOG_DIR is relative to the process CWD locally (apps/api/logs); Docker sets
# it to /app/logs.
# LOG_LEVEL=INFO
# LOG_DIR=logs
# LOG_FILE_NAME=app.log
# LOG_TO_FILE=true
# LOG_TO_CONSOLE=true
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# LOG_CAPTURE_UVICORN=true
