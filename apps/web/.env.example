# --- Auth0 (optional login, ADR-0015) ---
# Copy to .env.local (gitignored) and fill in from the Auth0 dashboard.
# Tenant domain, no scheme, e.g. dev-xxxx.us.auth0.com
AUTH0_DOMAIN=
# Regular Web Application credentials
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption secret: openssl rand -hex 32
AUTH0_SECRET=
# Where this app runs; Auth0 callback URL must be <APP_BASE_URL>/auth/callback
APP_BASE_URL=http://localhost:3002
# IMPORTANT: must match an Auth0 API identifier (Dashboard -> APIs) or access
# tokens come back opaque and fail backend JWT validation.
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email

# --- Backend API ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# --- Google tag (gtag.js) ---
# Google Ads / GA config ID (e.g. AW-XXXXXXXXXX). Public value, ships to browser.
# In prod, injected from the secrets manager. Leave empty to disable the tag.
NEXT_PUBLIC_GTAG_ID=
